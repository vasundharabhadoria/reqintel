.req-tabs {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1.25rem;
  border-bottom: 1px solid var(--border-color, #e2e2e2);
}

.req-tab {
  padding: 0.6rem 1rem;
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  cursor: pointer;
  font-weight: 500;
  color: var(--text-muted, #666);
}

.req-tab.active {
  color: var(--accent-color, #2563eb);
  border-bottom-color: var(--accent-color, #2563eb);
}

.req-source-row,
.req-list-row {
  display: grid;
  grid-template-columns: 1fr auto auto auto;
  align-items: center;
  gap: 1rem;
  padding: 0.75rem 1rem;
  border-bottom: 1px solid var(--border-color, #eee);
}

.req-status-pill {
  display: inline-block;
  padding: 0.15rem 0.6rem;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: capitalize;
}

.req-status-pending { background: #fef3c7; color: #92400e; }
.req-status-approved { background: #dcfce7; color: #166534; }
.req-status-rejected { background: #fee2e2; color: #991b1b; }
.req-status-deprecated { background: #e5e7eb; color: #374151; }

.req-status-uploaded { background: #e0e7ff; color: #3730a3; }
.req-status-parsing { background: #fef3c7; color: #92400e; }
.req-status-completed { background: #dcfce7; color: #166534; }
.req-status-failed { background: #fee2e2; color: #991b1b; }

.req-version-item {
  border-left: 2px solid var(--border-color, #e2e2e2);
  padding: 0.5rem 0 0.5rem 1rem;
  margin-bottom: 0.5rem;
}

.req-version-item.current {
  border-left-color: var(--accent-color, #2563eb);
}
.analyze-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  white-space: nowrap;
}

.analyze-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  backdrop-filter: blur(2px);
}

.analyze-modal {
  position: relative;
  width: 520px;
  max-width: calc(100vw - 32px);
  background: #ffffff;
  border-radius: 18px;
  padding: 32px;
  box-shadow: 0 24px 70px rgba(15, 23, 42, 0.25);
}

.analyze-modal-close {
  position: absolute;
  top: 22px;
  right: 22px;
  border: none;
  background: transparent;
  cursor: pointer;
  color: #0f172a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.analyze-modal-close:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.analyze-icon {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: #eef4ff;
  color: #1649ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18px;
}

.analyze-modal h2 {
  margin: 0;
  font-size: 24px;
  color: #111827;
}

.analyze-subtitle {
  margin: 8px 0 26px;
  color: #475569;
  font-size: 14px;
  line-height: 1.5;
}

.analyze-progress {
  width: 100%;
  height: 8px;
  background: #e7ebf5;
  border-radius: 999px;
  overflow: hidden;
  margin-bottom: 8px;
}

.analyze-progress-bar {
  height: 100%;
  border-radius: 999px;
  background: #1746ff;
  transition: width 0.5s ease;
}

.analyze-progress-bar.running {
  width: 65%;
}

.analyze-progress-bar.complete {
  width: 100%;
}

.analyze-progress-text {
  text-align: right;
  color: #1746ff;
  font-weight: 600;
  font-size: 14px;
  margin-bottom: 26px;
}

.analyze-step {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  min-height: 68px;
  position: relative;
}

.analyze-step:not(:last-child)::after {
  content: "";
  position: absolute;
  left: 10px;
  top: 28px;
  height: 42px;
  border-left: 2px dashed #dbe3f3;
}

.step-icon {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1746ff;
  background: white;
  position: relative;
  z-index: 1;
}

.empty-circle {
  width: 18px;
  height: 18px;
  border: 2px solid #9aa8c2;
  border-radius: 50%;
}

.step-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.step-content strong {
  font-size: 14px;
  color: #111827;
}

.step-content span {
  font-size: 13px;
  color: #475569;
  line-height: 1.4;
}

.step-status {
  font-size: 13px;
  font-weight: 600;
  color: #1746ff;
  white-space: nowrap;
}

.pending .step-status {
  color: #64748b;
  font-weight: 500;
}

.redirect-message {
  margin-top: 8px;
  text-align: center;
  color: #1746ff;
  font-size: 14px;
  font-weight: 600;
}

.spin {
  animation: analyze-spin 1s linear infinite;
}

@keyframes analyze-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 900px) {
  .workspace-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .workspace-header > div {
    flex-wrap: wrap;
  }

  .analyze-button {
    width: 100%;
  }
}
/* UI: document source cards */
.req-source-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.req-source-row {
  display: grid;
  grid-template-columns: minmax(220px, 1fr) auto auto auto;
  align-items: center;
  gap: 14px;
  padding: 16px 18px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  box-sizing: border-box;
}

.req-source-row > div:first-child strong {
  display: block;
  font-size: 14px;
  color: #111827;
  margin-bottom: 4px;
}

.req-source-row .btn {
  white-space: nowrap;
}

/* UI: requirements toolbar */
.requirements-panel .workspace-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
}

.requirements-panel .workspace-header > div:last-child {
  display: flex !important;
  align-items: center;
  gap: 10px !important;
  flex-wrap: wrap;
}

.requirements-panel input[type="search"] {
  width: 240px;
  height: 40px;
  padding: 0 12px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  outline: none;
  font-size: 14px;
  color: #1f2937;
  box-sizing: border-box;
}

.requirements-panel select {
  height: 40px;
  padding: 0 12px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #ffffff;
  font-size: 14px;
  color: #1f2937;
  outline: none;
}

.requirements-panel input[type="search"]:focus,
.requirements-panel select:focus {
  border-color: #1c64f2;
}

.requirements-panel .analyze-button {
  height: 40px;
}

/* UI: requirement repository cards */
.req-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 20px;
}

.req-list-row {
  width: 100%;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 20px;
  padding: 16px 18px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  color: #1f2937;
  text-align: left;
  cursor: pointer;
  box-sizing: border-box;
  font-family: inherit;
}

.req-list-row:hover {
  border-color: #bfdbfe;
  background: #f8fbff;
}

.req-list-row strong {
  font-size: 14px;
  font-weight: 700;
  color: #111827;
}

.req-list-row .muted-text {
  margin-top: 6px;
  line-height: 1.45;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.req-list-row .req-status-pill {
  flex-shrink: 0;
}
