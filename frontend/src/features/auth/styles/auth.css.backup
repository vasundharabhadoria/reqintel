.auth-page {
  --auth-primary: #1c64f2;
  --auth-primary-dark: #1650c4;
  --auth-teal: #0d9488;
  --auth-card-bg: #ffffff;
  --auth-border: #e2e8f0;
  --auth-text: #1f2937;
  --auth-text-muted: #6b7280;
  --auth-error-bg: #fef2f2;
  --auth-error-border: #fecaca;
  --auth-error-text: #b91c1c;

  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #eef4fc 0%, #f7fafe 100%);
  font-family: "Segoe UI", Roboto, Arial, sans-serif;
  color: var(--auth-text);
  padding-bottom: 48px;
}

.auth-language-selector {
  position: absolute;
  top: 24px;
  right: 32px;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  background: var(--auth-card-bg);
  border: 1px solid var(--auth-border);
  border-radius: 999px;
  font-size: 14px;
  color: var(--auth-text-muted);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
}

.auth-panels {
  display: flex;
  min-height: 100vh;
  align-items: stretch;
}

/* ---------- Hero (left) panel ---------- */

.auth-hero {
  flex: 1 1 54%;
  max-width: 54%;
  padding: 64px 56px 32px;
  display: flex;
  flex-direction: column;
}

.auth-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 16px;
}

.auth-logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--auth-primary), var(--auth-teal));
  color: #fff;
  font-weight: 700;
  font-size: 18px;
}

.auth-brand-name {
  font-size: 22px;
  font-weight: 700;
  color: var(--auth-text);
}

.auth-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  align-self: flex-start;
  padding: 4px 12px;
  border-radius: 999px;
  background: rgba(28, 100, 242, 0.1);
  color: var(--auth-primary);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.4px;
  margin-bottom: 20px;
}

.auth-hero-heading {
  font-size: 30px;
  line-height: 1.3;
  font-weight: 700;
  margin: 0 0 12px;
  color: #0f172a;
}

.auth-highlight {
  color: var(--auth-primary);
}

.auth-hero-subheading {
  font-size: 18px;
  font-weight: 600;
  color: var(--auth-teal);
  margin: 0 0 12px;
  line-height: 1.4;
}

.auth-hero-description {
  font-size: 14px;
  color: var(--auth-text-muted);
  line-height: 1.6;
  max-width: 460px;
  margin: 0 0 28px;
}

.auth-feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-bottom: 28px;
}

.auth-feature-card {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  padding: 14px;
  background: var(--auth-card-bg);
  border: 1px solid var(--auth-border);
  border-radius: 12px;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
}

.auth-feature-icon {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 8px;
  background: rgba(28, 100, 242, 0.1);
  color: var(--auth-primary);
}

.auth-feature-card h3 {
  margin: 0 0 2px;
  font-size: 13px;
  font-weight: 600;
  color: var(--auth-text);
}

.auth-feature-card p {
  margin: 0;
  font-size: 12px;
  color: var(--auth-text-muted);
  line-height: 1.4;
}

.auth-hero-illustration {
  position: relative;
  margin-top: auto;
  min-height: 140px;
  display: flex;
  align-items: flex-end;
}

.auth-hero-illustration-accent {
  position: absolute;
  right: 12px;
  bottom: 0;
  width: 110px;
  opacity: 0.15;
  transform: rotate(8deg);
  pointer-events: none;
}

.auth-mock-card {
  position: relative;
  background: var(--auth-card-bg);
  border: 1px solid var(--auth-border);
  border-radius: 14px;
  padding: 16px 18px;
  width: 260px;
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
}

.auth-mock-row {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: var(--auth-text-muted);
  margin-bottom: 6px;
}

.auth-mock-row strong {
  color: var(--auth-text);
  font-size: 13px;
}

.auth-mock-bars {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  height: 40px;
  margin-top: 10px;
}

.auth-mock-bars span {
  flex: 1;
  background: linear-gradient(180deg, var(--auth-primary), var(--auth-teal));
  border-radius: 3px;
}

.auth-hero-footer {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--auth-text-muted);
  margin-top: 20px;
}

/* ---------- Form (right) panel ---------- */

.auth-form-section {
  flex: 1 1 46%;
  max-width: 46%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 32px;
}

.auth-card {
  width: 100%;
  max-width: 400px;
  background: var(--auth-card-bg);
  border: 1px solid var(--auth-border);
  border-radius: 16px;
  padding: 36px 32px;
  box-shadow: 0 20px 40px rgba(15, 23, 42, 0.06);
}

.auth-card h1 {
  margin: 0 0 4px;
  font-size: 24px;
  font-weight: 700;
  color: #0f172a;
}

.auth-card-subtitle {
  margin: 0 0 24px;
  font-size: 14px;
  color: var(--auth-text-muted);
}

.auth-field {
  margin-bottom: 18px;
  text-align: left;
}

.auth-field label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--auth-text);
  margin-bottom: 6px;
}

.auth-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.auth-input-icon {
  position: absolute;
  left: 12px;
  color: var(--auth-text-muted);
  pointer-events: none;
}

.auth-input-wrapper input {
  width: 100%;
  padding: 11px 12px 11px 38px;
  border: 1px solid var(--auth-border);
  border-radius: 10px;
  font-size: 14px;
  color: var(--auth-text);
  outline: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.auth-input-wrapper input:focus {
  border-color: var(--auth-primary);
  box-shadow: 0 0 0 3px rgba(28, 100, 242, 0.12);
}

.auth-password-toggle {
  position: absolute;
  right: 10px;
  background: none;
  border: none;
  padding: 4px;
  cursor: pointer;
  color: var(--auth-text-muted);
  display: flex;
}

.auth-password-toggle:hover {
  color: var(--auth-text);
}

.auth-options-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  font-size: 13px;
}

.auth-checkbox-row {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--auth-text-muted);
  cursor: pointer;
}

.auth-checkbox-row input {
  width: 15px;
  height: 15px;
}

.auth-link-button {
  background: none;
  border: none;
  padding: 0;
  color: var(--auth-primary);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
}

.auth-inline-note {
  font-size: 12px;
  color: var(--auth-text-muted);
  margin: -12px 0 16px;
}

.auth-submit-button {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px;
  border: none;
  border-radius: 10px;
  background: var(--auth-primary);
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s ease;
}

.auth-submit-button:hover:not(:disabled) {
  background: var(--auth-primary-dark);
}

.auth-submit-button:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.auth-divider {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 22px 0;
  font-size: 12px;
  color: var(--auth-text-muted);
}

.auth-divider::before,
.auth-divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--auth-border);
}

.auth-oauth-button {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 11px;
  border: 1px solid var(--auth-border);
  border-radius: 10px;
  background: #fff;
  color: var(--auth-text);
  font-size: 14px;
  font-weight: 500;
  cursor: not-allowed;
  opacity: 0.7;
}

.auth-google-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  font-size: 18px;
  font-weight: 700;
  font-family: Arial, sans-serif;
  color: #4285f4;
}

.auth-footer {
  text-align: center;
  margin-top: 22px;
  font-size: 13px;
  color: var(--auth-text-muted);
}

.auth-footer a,
.auth-footer button {
  color: var(--auth-primary);
  font-weight: 600;
  text-decoration: none;
}

.auth-error-box {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 10px 12px;
  background: var(--auth-error-bg);
  border: 1px solid var(--auth-error-border);
  color: var(--auth-error-text);
  border-radius: 8px;
  font-size: 13px;
  margin-bottom: 18px;
}

.auth-success-box {
  padding: 10px 12px;
  background: #ecfdf5;
  border: 1px solid #a7f3d0;
  color: #047857;
  border-radius: 8px;
  font-size: 13px;
  margin-bottom: 18px;
}

.auth-security-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-size: 12px;
  color: var(--auth-text-muted);
  margin-top: 8px;
}

.auth-route-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  font-family: "Segoe UI", Roboto, Arial, sans-serif;
  color: #6b7280;
}

/* ---------- Responsive ---------- */

@media (max-width: 1024px) {
  .auth-hero {
    padding: 48px 36px 24px;
  }

  .auth-form-section {
    padding: 32px 24px;
  }

  .auth-feature-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 860px) {
  .auth-panels {
    flex-direction: column;
  }

  .auth-hero,
  .auth-form-section {
    max-width: 100%;
    flex: none;
  }

  .auth-hero {
    padding: 72px 24px 24px;
  }

  .auth-hero-illustration {
    display: none;
  }

  .auth-language-selector {
    top: 16px;
    right: 16px;
  }
}

@media (max-width: 480px) {
  .auth-card {
    padding: 28px 20px;
    border-radius: 12px;
  }

  .auth-hero-heading {
    font-size: 24px;
  }
}