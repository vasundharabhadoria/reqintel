.projects-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 16px;
}

.search-input-wrapper {
  position: relative;
  flex: 1;
  min-width: 220px;
  max-width: 340px;
}

.search-input-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: #9ca3af;
}

.search-input-wrapper input {
  width: 100%;
  padding: 10px 12px 10px 36px;
  border-radius: 8px;
  border: 1px solid #e2e8f0;
  font-size: 14px;
  outline: none;
  box-sizing: border-box;
}

.search-input-wrapper input:focus {
  border-color: #1c64f2;
}

.status-filter {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: #4b5563;
}

.status-filter select {
  padding: 8px 10px;
  border-radius: 8px;
  border: 1px solid #e2e8f0;
  font-size: 13px;
  background: #fff;
}

.projects-table-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  overflow: hidden;
}

.projects-table {
  width: 100%;
  border-collapse: collapse;
}

.projects-table th {
  text-align: left;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  color: #6b7280;
  padding: 12px 16px;
  border-bottom: 1px solid #e2e8f0;
  background: #f9fafb;
}

.projects-table td {
  padding: 14px 16px;
  border-bottom: 1px solid #f1f5f9;
  font-size: 14px;
  color: #1f2937;
  vertical-align: middle;
}

.projects-table tr:last-child td {
  border-bottom: none;
}

.project-name-cell {
  display: flex;
  align-items: center;
  gap: 10px;
}

.project-name-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border-radius: 8px;
  background: rgba(28, 100, 242, 0.1);
  color: #1c64f2;
  font-weight: 700;
  font-size: 13px;
  flex-shrink: 0;
}

.project-name-text {
  font-weight: 600;
}

.projects-table-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.row-menu {
  position: relative;
}

.row-menu-trigger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 8px;
  border: 1px solid #e2e8f0;
  background: #fff;
  color: #4b5563;
  cursor: pointer;
}

.row-menu-trigger:hover {
  background: #f9fafb;
}

.row-menu-dropdown {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.12);
  min-width: 140px;
  z-index: 1000;
  overflow: hidden;
}

.row-menu-dropdown button {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 10px 12px;
  border: none;
  background: none;
  cursor: pointer;
  font-size: 13px;
  color: #374151;
  text-align: left;
}

.row-menu-dropdown button:hover {
  background: #f3f4f6;
}

.row-menu-danger {
  color: #b91c1c !important;
}

.table-footer-row {
  padding: 12px 16px;
  font-size: 13px;
  color: #6b7280;
  border-top: 1px solid #e2e8f0;
}

.project-modal-subtitle {
  margin: -8px 0 16px;
  font-size: 13px;
  color: #6b7280;
}

.project-form-error {
  background: #fef2f2;
  border: 1px solid #fecaca;
  color: #b91c1c;
  padding: 10px 12px;
  border-radius: 8px;
  font-size: 13px;
  margin-bottom: 14px;
}

.project-form-field {
  margin-bottom: 16px;
}

.project-form-field label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: #374151;
  margin-bottom: 6px;
}

.project-form-input-wrapper {
  position: relative;
}

.project-form-input-icon {
  position: absolute;
  left: 12px;
  top: 12px;
  color: #9ca3af;
}

.project-form-input-wrapper input,
.project-form-input-wrapper textarea {
  width: 100%;
  padding: 10px 12px 10px 34px;
  border-radius: 8px;
  border: 1px solid #e2e8f0;
  font-size: 14px;
  font-family: inherit;
  outline: none;
  box-sizing: border-box;
}

.project-form-input-wrapper input:focus,
.project-form-input-wrapper textarea:focus {
  border-color: #1c64f2;
}

.project-form-textarea-wrapper textarea {
  resize: vertical;
}

.project-form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 20px;
}

.archive-modal-text {
  font-size: 14px;
  color: #374151;
  margin: 0 0 14px;
}

.archive-modal-warning {
  display: flex;
  gap: 8px;
  padding: 10px 12px;
  background: #fffbeb;
  border: 1px solid #fde68a;
  border-radius: 8px;
  font-size: 13px;
  color: #92400e;
  margin-bottom: 6px;
}

.archive-modal-warning svg {
  flex-shrink: 0;
  margin-top: 1px;
}

.btn-link-back {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: none;
  border: none;
  color: #4b5563;
  font-size: 13px;
  cursor: pointer;
  padding: 0;
  margin-bottom: 16px;
}

.btn-link-back:hover {
  color: #1c64f2;
}

.workspace-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 24px;
}

.workspace-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}

.workspace-header h1 {
  margin: 0 0 4px;
  font-size: 22px;
  color: #111827;
}

.workspace-meta {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 16px;
  margin: 0 0 20px;
  padding: 16px 0;
  border-top: 1px solid #f1f5f9;
  border-bottom: 1px solid #f1f5f9;
}

.workspace-meta dt {
  font-size: 12px;
  color: #6b7280;
  margin-bottom: 4px;
}

.workspace-meta dd {
  margin: 0;
  font-size: 14px;
  font-weight: 600;
  color: #1f2937;
}

.workspace-description h2 {
  font-size: 15px;
  margin: 0 0 6px;
  color: #111827;
}

.workspace-description p {
  font-size: 14px;
  color: #4b5563;
  line-height: 1.6;
  margin: 0 0 20px;
}