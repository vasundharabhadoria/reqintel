SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=

# Public URL of the React app. Used for email-confirmation, password-recovery
# and OAuth redirects. Must also be allow-listed in Supabase.
FRONTEND_URL=http://localhost:5173

# Set to true ONLY behind a reverse proxy you control (rate limiting then
# reads the client IP from X-Forwarded-For).
TRUST_PROXY_HEADERS=false